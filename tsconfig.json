{
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "types": [],
    "rootDir": "./cod_fonte",
    "outDir": "./cod_result",
    "strict": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
